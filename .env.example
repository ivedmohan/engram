# FalkorDB (docker compose up -d)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Engram daemon
ENGRAM_PORT=7777

# LLM provider for extraction/reconciliation (T4).
# Only "groq" is wired up for now — users bring their own Groq API key (free tier works).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings — Ollama is the fully-local default; dimension must match the model
EMBEDDING_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
